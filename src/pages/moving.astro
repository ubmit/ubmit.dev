---
import BaseHead from "../components/BaseHead.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ActivityGraph from "../components/ActivityGraph/index.astro";
import { getActivities } from "../lib/strava";
import { SITE_DESCRIPTION } from "../consts";
import SectionHeading from "../components/SectionHeading.astro";
import "../styles/base.css";

const activities = await getActivities();
---

<html lang="en">
  <head>
    <BaseHead title="Moving" description={SITE_DESCRIPTION} />
  </head>
  <BaseLayout>
    <section class="grid grid-cols-[140px_1fr] gap-6 border-t border-[var(--ledger-line)] pt-6">
      <SectionHeading title="Moving" />
      <ActivityGraph activities={activities} />
    </section>
  </BaseLayout>
</html>
