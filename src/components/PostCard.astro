---
import FormattedDate from "./FormattedDate.astro";

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  href: string;
  featured?: boolean;
}

const { title, description, pubDate, href, featured = false } = Astro.props;
---

<li class="pb-3 pt-3 first:pt-0 last:pb-0">
  <a
    href={href}
    class="group text-gray-1100 transition-colors hover:text-gray-1200"
  >
    <div class="flex items-baseline justify-between gap-4">
      <div class="flex items-baseline gap-3">
        <span class="font-medium">{title}</span>
        {
          featured && (
            <span class="text-gray-1000 rounded-full border border-ledger-line px-2 py-0.5 text-[10px] font-mono uppercase tracking-[0.18em]">
              Featured
            </span>
          )
        }
      </div>
      <span class="text-gray-900 text-xs font-mono">
        <FormattedDate date={pubDate} />
      </span>
    </div>
    {
      description && (
        <span class="text-gray-1000 mt-1 block text-sm leading-relaxed">
          {description}
        </span>
      )
    }
  </a>
</li>
