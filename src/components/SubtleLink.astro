---
interface Props {
  href: string;
  target?: string;
}

const { href, target } = Astro.props;
---

<a
  href={href}
  target={target}
  rel="noopener noreferrer"
  class="decoration-gray-600 hover:text-gray-1200 hover:decoration-gray-800 underline underline-offset-4 transition-colors"
>
  <slot /></a
>
