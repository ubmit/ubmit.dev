---
interface Props {
  href: string;
  target?: string;
}

const { href, target } = Astro.props;
---

<a
  href={href}
  target={target}
  rel="noopener noreferrer"
  class="hover:text-gray-1200 underline decoration-gray-600 underline-offset-4 transition-colors hover:decoration-gray-800"
>
  <slot /></a
>
